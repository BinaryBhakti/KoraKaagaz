# Reply form (Classifieds, P. 09) → /api/enquiry → email via Google Workspace SMTP.
# SMTP_PASS is a Google app password for SMTP_USER (needs 2-Step Verification), not the account password.
SMTP_USER=team@korakaagaz.co
SMTP_PASS=
# Optional: deliver to a different inbox (defaults to SMTP_USER).
ENQUIRY_TO=

# VERCEL_ENV is set by Vercel and controls indexing (only "production" is indexable).
