# Hero background: auto | brackets | horizon | terrain | silk | ink | glyphs | lines | ripple | spotlight
NEXT_PUBLIC_HERO_FIELD=horizon
# Cursor: ring | dot | brackets | glow
NEXT_PUBLIC_CURSOR_STYLE=ring
NEXT_PUBLIC_CUSTOM_CURSOR=true
NEXT_PUBLIC_INTRO=true
NEXT_PUBLIC_MOTION=true
NEXT_PUBLIC_SCRIPT_ACCENT=true

# Enquiries: POST JSON to this endpoint; otherwise falls back to a mailto: to the studio email.
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_STUDIO_EMAIL=

NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_BEHANCE_URL=
